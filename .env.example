# Copy to .env; generate independent random values of at least 32 characters.
DATABASE_USERNAME=agentflow
DATABASE_PASSWORD=
JWT_SECRET=
ENGINE_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Docker paths; host workspace directory is mounted at /workspaces in both services.
WORKSPACE_HOST_PATH=./workspaces
WORKSPACE_ROOT=/workspaces
DATABASE_URL=jdbc:postgresql://postgres:5432/agentflow
ENGINE_DATABASE_URL=postgresql+psycopg://agentflow:CHANGE_ME@postgres:5432/agentflow
REDIS_URL=redis://redis:6379
AGENT_ENGINE_URL=http://agent-engine:8000
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
CORS_ORIGIN=http://localhost:3000
LLM_TIMEOUT=180
SANDBOX_ENABLED=false
